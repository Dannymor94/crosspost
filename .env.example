# Configuration template. Copy to runtime/.env and fill in values.
# Real .env is never committed (see .gitignore).
# Generate secrets:
#   VAULT_KEY:            python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   SESSION_SECRET / MEDIA_URL_SECRET:  python -c "import secrets; print(secrets.token_hex(32))"

# ── Secrets (mandatory in prod; inject from env/secret-store, not .env file) ─
SESSION_SECRET=
VAULT_KEY=
MEDIA_URL_SECRET=

# Compose-only DNS and dedicated trusted Caddy network (T-302).
CROSSPOST_DOMAIN=
CROSSPOST_PROXY_SUBNET=172.30.92.0/24
CROSSPOST_PROXY_IP=172.30.92.2
CROSSPOST_APP_IP=172.30.92.3

# ── Database and paths ────────────────────────────────────────────────────────
# Default: sqlite+aiosqlite:///runtime/db.sqlite3 (created on first run)
DB_URL=sqlite+aiosqlite:///runtime/db.sqlite3
MEDIA_DIR=runtime/media
SCREENSHOT_DIR=runtime/screenshots
RUNTIME_SETTINGS_PATH=runtime/settings.json
BROWSER_PROFILES_DIR=runtime/profiles

# ── Browser ───────────────────────────────────────────────────────────────────
# false = headful (dev); true = headless (server). Login is always headful.
BROWSER_HEADLESS=false
# Cooldown between browser sessions for the same account group (seconds).
BROWSER_SESSION_COOLDOWN_SECONDS=300

# ── Scheduler ─────────────────────────────────────────────────────────────────
SCHEDULER_ENABLED=true
SCHEDULER_POLL_SECONDS=30
SCHEDULER_PACING_SECONDS=5
SCHEDULER_MAX_ATTEMPTS=3

# Health check: periodic background validation of connections
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_POLL_SECONDS=300

# Readiness/monitoring (T-304). /health fails closed when scheduler stalls.
HEALTH_SCHEDULER_MAX_SILENCE_SECONDS=600
HEALTH_SCHEDULER_MAX_ERRORS=3
# 0 disables error-spike warning, otherwise count ERROR entries in the last N minutes.
HEALTH_ERROR_THRESHOLD=10
HEALTH_ERROR_WINDOW_MINUTES=15
HEALTH_DB_TIMEOUT_SECONDS=3
HEALTH_ERROR_REFRESH_SECONDS=60

# ── Import plan ───────────────────────────────────────────────────────────────
IMPORT_PACING_SECONDS=2.0
IMPORT_MAX_IMAGES=200
IMPORT_MAX_CONCURRENCY=3
IMPORT_MAX_BYTES=52428800
IMPORT_IMAGE_MAX_BYTES=5242880

# ── Media ─────────────────────────────────────────────────────────────────────
MEDIA_URL_TTL_SECONDS=3600
VIDEO_MAX_BYTES=524288000

# ── Telegram (web app — channel connection wizard) ────────────────────────────
# Fallback credentials used only for connection check if not stored in vault.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ── Instagram ─────────────────────────────────────────────────────────────────
# Public base URL for signed media links sent to Instagram Graph API.
# Required for Instagram publishing. Use make tunnel or set a real URL.
INSTAGRAM_PUBLIC_BASE_URL=
INSTAGRAM_PROXY_URL=
INSTAGRAM_TUNNEL_AUTO=false
INSTAGRAM_GRAPH_VERSION=v26.0
INSTAGRAM_POLL_SECONDS=30
INSTAGRAM_POLL_TIMEOUT_SECONDS=300

# ── CLI only (python -m crosspost) ───────────────────────────────────────────
# Telegram CLI publishing
# TG_API_ID=  # deprecated alias for TELEGRAM_API_ID
# TG_API_HASH=  # deprecated alias for TELEGRAM_API_HASH
TG_SESSION_PATH=runtime/sessions/telegram.session
TG_TARGET_CHANNEL=

# VK API
VK_ACCESS_TOKEN=
VK_GROUP_ID=
VK_PHOTO_UPLOAD_ENABLED=true

# VK browser (vk_wall)
VK_GROUP_SCREEN_NAME=
VK_GROUP_URL=

# VK channel browser
VK_CHANNEL_ID=

# Russian proxy for VK browser channels (vk_wall, vk_channel); required on non-RU servers
VK_PROXY_URL=

# Yandex Дzen browser
YANDEX_ORG_ID=

# Russian proxy for Yandex browser channel; required on non-RU servers
YANDEX_PROXY_URL=


# Persistent rate-limit breaker per (profile, channel); invalid values use safe defaults.
# Cooldown: 1..86400 seconds; validated Retry-After can extend it up to 86400s.
BREAKER_COOLDOWN_SECONDS=300
# Lease expiry quarantines the probe until explicit verified recovery (1..3600s).
BREAKER_LEASE_SECONDS=600

# CLI user-add password (alternative to --password flag)
CROSSPOST_PASSWORD=

# T-407: enable only for isolated tests until public onboarding security gates pass.
CLIENT_INVITATIONS_ENABLED=false

# T-409 draft. Production mode requires trusted HTTPS, Secure/Strict cookie and rate limits.
CROSSPOST_AUTH_MODE=development
CROSSPOST_AUTH_RATE_LIMIT=false

# T-409 CSRF draft: production always enables it; exact HTTPS public origin required.
CROSSPOST_CSRF_ENABLED=false
CROSSPOST_AUTH_ORIGIN=

# T-515: initial API credential connection for own client profile, isolated pilot only.
CLIENT_API_CONNECTION_ENABLED=false

# T-517: opt-in installable web app; no cached private responses or offline sends.
CROSSPOST_PWA_ENABLED=false

# T-515: initial client Telegram flow, isolated pilot only.
CLIENT_TELEGRAM_CONNECTION_ENABLED=false

# Web/scheduler external publication gate; production requires explicit true.
CROSSPOST_LIVE_PUBLICATION_ENABLED=false
